{
  "name": "aep-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Environment Protocol (AEP) multi-endpoint harness (shared core + Web UI)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node dist/cli.js",
    "test": "npm run build && node --test test/harness.test.ts"
  },
  "dependencies": {
    "aep-node": "file:../aep-node"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
